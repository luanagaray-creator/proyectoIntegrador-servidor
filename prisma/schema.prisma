generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  name     String  @unique(map: "users_name_unique") @db.VarChar(30)
  password String  @db.VarChar(255)
  idUser   String  @id @db.VarChar(10)
  typeUser String  @db.VarChar(12)
  groupCode String? @db.VarChar(7)
  email    String  @unique(map: "users_email_unique") @db.VarChar(30)
  cellPhone Decimal? @db.Decimal(9, 0)

  @@map("users")
}

model AuthSession {
  tokenHash String @id @db.Char(64)
  idUser String @db.VarChar(10)
  expiresAt DateTime @db.DateTime(0)

  @@index([idUser], map: "auth_sessions_user")
  @@index([expiresAt], map: "auth_sessions_expiration")
  @@map("auth_sessions")
}

model Mesage {
  content        String  @db.Text
  addressee      String  @db.VarChar(30)
  priorityMesage String  @db.VarChar(5)
  dateMesage     Decimal @db.Decimal(8, 0)
  idMesage       String  @id @db.VarChar(10)
  threadId String? @db.Char(10)
  senderId String? @db.VarChar(10)
  recipientId String? @db.VarChar(10)
  sentAt DateTime? @db.DateTime(3)
  sequence BigInt @unique @default(autoincrement()) @db.UnsignedBigInt

  @@index([threadId, sequence], map: "mesages_thread_sequence")

  @@map("mesages")
}

model MessageThread {
  spaceId String? @db.Char(10)

  @@index([spaceId], map: "message_thread_space")
  id String @id @db.Char(10)
  subject String @db.VarChar(120)
  senderId String @db.VarChar(10)
  recipientId String @db.VarChar(10)
  createdAt DateTime @db.DateTime(3)

  @@index([senderId], map: "message_threads_sender")
  @@index([recipientId], map: "message_threads_recipient")
  @@map("message_threads")
}

model MessageStar {
  idUser String @db.VarChar(10)
  threadId String @db.Char(10)

  @@id([idUser, threadId])
  @@index([threadId], map: "message_stars_thread")
  @@map("message_stars")
}

model SchoolGroup {
  code String @id @db.VarChar(7)

  @@map("school_groups")
}

model AdminPlanGroup {
  adminId String @db.VarChar(10)
  groupCode String @db.VarChar(7)

  @@id([adminId, groupCode])
  @@index([groupCode], map: "admin_plan_groups_group")
  @@map("admin_plan_groups")
}

model GroupChatMessage {
  spaceId String? @db.Char(10)

  @@index([spaceId, id], map: "group_chat_space_id")
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  groupCode String @db.VarChar(7)
  senderId String @db.VarChar(10)
  content String @db.Text
  sentAt DateTime @db.DateTime(3)

  @@index([groupCode, id], map: "group_chat_group_id")
  @@map("group_chat_messages")
}

model Notification {
  priorityNotification String @db.VarChar(5)
  dateNotification     String @db.VarChar(8)
  sender               String @db.VarChar(30)
  idNotification       String @id @db.VarChar(10)

  @@map("notifications")
}

model Facturation {
  dateFacturation Decimal @db.Decimal(8, 0)
  nameFacturation String  @db.VarChar(30)
  lastDigits      Decimal @db.Decimal(4, 0)
  senderAddress   String  @db.VarChar(30)
  paidService     String  @db.VarChar(30)
  idFacturation   String  @id @db.VarChar(10)

  @@map("facturations")
}

model PaymentDetails {
  cardNumber       Decimal @db.Decimal(16, 0)
  CVC              Decimal @db.Decimal(3, 0)
  nameCard         Decimal @db.Decimal(30, 0)
  expirationDate   Decimal @db.Decimal(4, 0)
  idPaymentDetails String  @id @db.VarChar(10)

  @@map("paymentDetails")
}

model Subscription {
  dateSuscription   Decimal @db.Decimal(8, 0)
  typeSuscription   String  @db.VarChar(10)
  maturityDate      Decimal @db.Decimal(8, 0)
  idSubscription    String  @id @db.VarChar(10)

  @@map("subscriptions")
}

model Institution {
  id String @id @db.Char(10)
  name String @unique @db.VarChar(80)
  @@map("institutions")
}
model CommunicationSpace {
  id String @id @db.Char(10)
  institutionId String @db.Char(10)
  name String @db.VarChar(30)
  @@unique([institutionId, name], map: "institution_space")
  @@map("communication_spaces")
}
model SpaceAdministrator {
  spaceId String @db.Char(10)
  idUser String @db.VarChar(10)
  @@id([spaceId, idUser])
  @@index([idUser], map: "space_admin_user")
  @@map("space_administrators")
}
model SpaceMembership {
  spaceId String @db.Char(10)
  idUser String @db.VarChar(10)
  grantedBy String @db.VarChar(10)
  @@id([spaceId, idUser])
  @@index([idUser], map: "space_member_user")
  @@map("space_memberships")
}
model AdminPlanSpace {
  adminId String @db.VarChar(10)
  spaceId String @db.Char(10)
  @@id([adminId, spaceId])
  @@index([spaceId], map: "plan_space")
  @@map("admin_plan_spaces")
}
